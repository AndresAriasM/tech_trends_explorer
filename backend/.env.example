# ==============================================================
# Prospecta — variables de entorno del backend
#
# Copia este archivo a `.env` y rellena los valores:
#     cp backend/.env.example backend/.env
#
# `.env` está en .gitignore y NUNCA debe commitearse.
# Verifica la configuración con:
#     backend/.venv/bin/python scripts/check_supabase.py
# ==============================================================

# ── Supabase / Postgres ───────────────────────────────────────
# Dashboard → Project Settings → Data API  (o el botón "Connect")
SUPABASE_URL=

# Clave de servidor. Salta todas las políticas RLS: SÓLO en el backend,
# jamás en una variable NEXT_PUBLIC_* ni en el frontend.
# Dashboard → Project Settings → API Keys
#   · sistema nuevo: la "secret key"  (sb_secret_...)
#   · sistema legacy: la "service_role key"  (un JWT largo)
SUPABASE_SERVICE_KEY=

# Clave pública, segura para el navegador (la usará el frontend más adelante).
#   · sistema nuevo: "publishable key"  (sb_publishable_...)
#   · sistema legacy: "anon key"
SUPABASE_ANON_KEY=

# Cadena de conexión Postgres, para SQL directo y migraciones.
# Dashboard → botón "Connect" → Connection string → URI
# Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos.
DATABASE_URL=

# ── Proveedor de IA ───────────────────────────────────────────
# El asistente y los votos sintéticos usan OpenAI (decisión de sept. 2026).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ── Fuentes de datos ──────────────────────────────────────────
SERP_API_KEY=
GOOGLE_API_KEY=
SEARCH_ENGINE_ID=
SCOPUS_API_KEY=

# ── Aplicación ────────────────────────────────────────────────
# Orígenes permitidos por CORS, separados por comas.
CORS_ORIGINS=http://localhost:3000

# Cámbiala en producción por un valor aleatorio largo.
SECRET_KEY=change_me_in_production

# ── Obsoleto: AWS DynamoDB ────────────────────────────────────
# Se migra a Supabase. Rellénalas sólo si necesitas leer datos
# antiguos de DynamoDB durante la transición.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-2
